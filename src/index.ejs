<!DOCTYPE html>
<html lang="en">

<head>
    <title>Hobbies Search</title>
    <meta charset="UTF-8">
    <meta name="description" content="A list of hobbies to learn more about or try out">
    <link rel="manifest" href="/manifest.json">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="shortcut icon" href="assets/img/icon.png">
</head>

<body>
    <div id="content" align="center">
        <img src="assets/img/logo.png" class="logo" alt="img/logo.png"><br />
        <div id="header">
            <input type="search" id="search" placeholder="Search through hobbies.." title="Type in a hobbie">
            <button id="btn1">Shuffle</button>

            <p>Click on an item to do a web search about the topic, or click shuffle to randomize.</p>
        </div>
        <div id="boxes"></div>
    </div>
    <div id="infobox" popover>
        <p><strong id="sitename"></strong></p>
        <p>Version: <strong id="version"></strong></p><br>
        <ul class="no-bullets">
            <li><i class="icon-link-ext"></i><a href="https://updates.dyntomas.com/projects/hobbies">Updates</a></li>
            <li><i class="icon-link-ext"></i><a href="https://hub.dyntomas.com/">Hub</a></li>
            <li><i class="icon-link-ext"></i></i><a href="https://hub.dyntomas.com/privacy">Privacy</a></li>
        </ul><br>
        <p>2026 Dyntomas</p>
    </div>
    <footer><button popovertarget="infobox"><i class="icon-info-circled"></i></button></footer>
</body>

</html>